include README.md INSTALL.md AGENTS.md LICENSE
recursive-include max_chronicle *.py *.sql *.md
recursive-include tests *.py
global-exclude *.pyc *.db *.db-wal *.db-shm *.jsonl .env .env.*
# The synthetic eval fixtures, by name; runtime ledgers stay excluded above.
include tests/fixtures/eval/corpus.jsonl tests/fixtures/eval/golden.jsonl
prune chronicle-artifacts
prune daybooks
prune logs
prune backups
